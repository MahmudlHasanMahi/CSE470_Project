generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  credential       PasswordCredential?
  refreshTokens    RefreshToken[]
  biometricDevices BiometricDevice[]

  roleId String? @map("role_id")
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  departmentId      String?     @map("department_id")
  department        Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartment Department? @relation("DepartmentManager")

  wallet            Wallet?
  walletMemberships WalletMember[]

  createdTxns Txn[] @relation("TxnCreatedBy")

  ledgerEntries     LedgerEntry[]
  importBatches     ImportBatch[]
  recurringPayments RecurringPayment[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("role")
}

model PasswordCredential {
  userId       String   @id @map("user_id")
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credential")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  replacedBy String?   @map("replaced_by")
  tokenHash  String    @unique @map("token_hash")
  authMethod String    @map("auth_method")
  deviceInfo String?   @map("device_info")
  issuedAt   DateTime  @default(now()) @map("issued_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model BiometricDevice {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  credentialId String    @unique @map("credential_id")
  publicKey    String    @map("public_key")
  counter      Int       @default(0)
  transports   String?
  deviceName   String?   @map("device_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("biometric_device")
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  managerId String?  @unique @map("manager_id")
  createdAt DateTime @default(now()) @map("created_at")

  manager User?  @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  members User[] @relation("DepartmentMembers")

  wallet Wallet?


  @@map("department")
}

model Wallet {
  id           String   @id @default(uuid())
  name         String
  type         String   @default("Department")
  userId       String?  @unique @map("user_id")
  departmentId String?  @unique @map("department_id")
  balance      Decimal  @default(0) @db.Decimal(14, 2)
  currency     String   @default("BDT")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  department Department?    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  members    WalletMember[]

  outgoingTxns Txn[] @relation("TxnSource")
  incomingTxns Txn[] @relation("TxnDestination")

  externalAccounts ExternalAccount[]

  @@map("wallet")
}

model WalletMember {
  id                  String   @id @default(uuid())
  walletId            String   @map("wallet_id")
  userId              String   @map("user_id")
  canSpend            Boolean  @default(false) @map("can_spend")
  perTransactionLimit Decimal? @map("per_transaction_limit") @db.Decimal(14, 2)
  dailyLimit          Decimal? @map("daily_limit") @db.Decimal(14, 2)
  monthlyLimit        Decimal? @map("monthly_limit") @db.Decimal(14, 2)
  rules               Json     @default("{}")
  status              String   @default("active")

  createdAt DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@unique([walletId, userId])
  @@map("wallet_member")
}

model ExternalAccount {
  id            String   @id @default(uuid())
  walletId      String?   @map("wallet_id")      // the wallet that may use this account
  label         String                          // e.g. "My bKash", "Office Supplier Ltd"
  method        String                          // "bank" | "mobile_wallet"
  providerName  String   @map("provider_name")  // e.g. "BRAC Bank", "bKash"
  accountHolder String   @map("account_holder") // plain text, not linked to users
  accountLast4  String   @map("account_last4")  // only the last 4 digits are stored
  status        String   @default("active")     // "active" | "removed"
  createdAt     DateTime @default(now()) @map("created_at")

  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: Restrict)
  txns   Txn[]

  @@index([walletId])
  @@map("external_account")
}
model Txn {
  id                  String   @id @default(uuid())
  reference           String   @unique              // human-readable code, generated by the service
  type                String   @default("expense")  // "transfer" | "expense" | "deposit" | "payout" | "payin"
  categoryId          String?  @map("category_id")  // plain string until a category table exists
  amount              Decimal  @db.Decimal(14, 2)
  status              String   @default("pending")
  sourceWalletId      String?  @map("source_wallet_id")
  destinationWalletId String?  @map("destination_wallet_id")
  externalAccountId   String?  @map("external_account_id")
  description         String?
  createdBy           String   @map("created_by")
  recurringPaymentId  String?  @map("recurring_payment_id") // plain string until that table exists
  occurredAt          DateTime @default(now()) @map("occurred_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  sourceWallet      Wallet?          @relation("TxnSource", fields: [sourceWalletId], references: [id], onDelete: Restrict)
  destinationWallet Wallet?          @relation("TxnDestination", fields: [destinationWalletId], references: [id], onDelete: Restrict)
  externalAccount   ExternalAccount? @relation(fields: [externalAccountId], references: [id], onDelete: Restrict)
  creator           User             @relation("TxnCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([sourceWalletId, occurredAt])
  @@index([destinationWalletId])
  @@index([externalAccountId])
  @@index([type])
  @@map("txn")
}



//ZR


enum LedgerDirection {
  IN
  OUT
}

enum LedgerSource {
  MANUAL
  IMPORT
  RECURRING
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

model ImportBatch {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")          // CHECK: must match User.id type
  fileName     String?       @map("file_name")
  totalRows    Int           @map("total_rows")
  importedRows Int           @map("imported_rows")
  failedRows   Int           @map("failed_rows")
  createdAt    DateTime      @default(now()) @map("created_at")
  user         User          @relation(fields: [userId], references: [id])
  entries      LedgerEntry[]

  @@map("import_batches")
}

model LedgerEntry {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")  // CHECK
  reference          String
  direction          LedgerDirection
  amount             Decimal          @db.Decimal(14, 2)
  currency           String           @default("BDT")
  paymentMethod      String           @map("payment_method")
  status             String           @default("COMPLETED")
  description        String?
  source             LedgerSource     @default(MANUAL)
  occurredAt         DateTime         @map("occurred_at")
  importBatchId      String?          @map("import_batch_id")
  recurringPaymentId String?          @map("recurring_payment_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  user               User             @relation(fields: [userId], references: [id])
  importBatch        ImportBatch?     @relation(fields: [importBatchId], references: [id])

  @@unique([userId, reference])
  @@index([userId, occurredAt])
  @@map("ledger_entries")
}

model RecurringPayment {
  id            String             @id @default(uuid())
  userId        String             @map("user_id")     // CHECK
  name          String
  amount        Decimal            @db.Decimal(14, 2)
  paymentMethod String             @map("payment_method")
  recipient     String
  frequency     RecurringFrequency
  startDate     DateTime           @map("start_date")
  nextDueDate   DateTime           @map("next_due_date")
  endDate       DateTime?          @map("end_date")
  autoPay       Boolean            @default(true) @map("auto_pay")
  status        RecurringStatus    @default(ACTIVE)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  user          User               @relation(fields: [userId], references: [id])

  @@index([userId, status, nextDueDate])
  @@map("recurring_payments")
}
